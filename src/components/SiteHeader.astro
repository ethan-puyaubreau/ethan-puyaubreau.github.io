---
import { site } from "../lib/site";
import type { NavSection } from "../lib/content";
import type { UIStrings } from "../lib/ui";
import { type Locale, LOCALES, DEFAULT_LOCALE, LOCALE_STORAGE_KEY, blogHome } from "../lib/i18n";
import LangSwitch from "./LangSwitch.astro";
import Mark from "./Mark.astro";

interface Props {
  locale: Locale;
  sections: readonly NavSection[];
  ui: UIStrings;
  /** Where the brand links. Defaults to the in-page top; sub-pages set this to
      the locale home so the mark behaves like a home link. */
  brandHref?: string;
  /** Per-locale URL for the language switch (sub-pages keep you on the page). */
  langPaths?: Partial<Record<Locale, string>>;
  /** Kept for the callers that still pass it; the bar is always solid now. */
  solid?: boolean;
}

const { locale, sections, ui, brandHref = "#top", langPaths } = Astro.props;
const blogHref = blogHome(locale);
// In-page anchors only make sense on the page that has them.
const inPage = brandHref === "#top";
---

<header id="site-header" class="site-header">
  <div class="bar">
    <a class="brand" href={brandHref} aria-label={`${site.name}, ${ui.homeLabel}`}>
      <Mark size={26} />
      <span class="brand-name">{site.name}</span>
    </a>

    {inPage && (
      <nav class="sections" aria-label={ui.sectionsLabel}>
        {sections.map((s) => (
          <a href={`#${s.id}`}>{s.label}</a>
        ))}
      </nav>
    )}

    <div class="bar-right">
      <a class="navlink" href={blogHref}>
        Blog
      </a>
      <LangSwitch
        locale={locale}
        locales={LOCALES}
        defaultLocale={DEFAULT_LOCALE}
        switchLabel={ui.langSwitchLabel}
        names={ui.langName}
        titles={ui.langSwitchTo}
        storageKey={LOCALE_STORAGE_KEY}
        paths={langPaths}
      />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    height: 3.5rem;
    max-width: var(--header-max);
    margin-inline: auto;
    padding-inline: var(--header-gutter);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }
  .brand-name {
    font-weight: 650;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .sections {
    display: flex;
    gap: var(--space-m);
    margin-left: auto;
  }
  .sections a,
  .navlink {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-dim);
    white-space: nowrap;
  }
  .sections a:hover,
  .navlink:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .bar-right {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    flex-shrink: 0;
    margin-left: auto;
  }
  .sections + .bar-right {
    margin-left: var(--space-m);
    padding-left: var(--space-m);
    border-left: 1px solid var(--line);
  }
  @media (max-width: 900px) {
    .sections {
      display: none;
    }
    .sections + .bar-right {
      margin-left: auto;
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 400px) {
    .brand :global(.mark) {
      display: none;
    }
  }
  @media (pointer: coarse) {
    .navlink,
    .brand {
      padding-block: 0.7rem;
    }
  }
</style>
