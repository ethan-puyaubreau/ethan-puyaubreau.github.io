---
import { site } from "../lib/site";
import type { NavSection } from "../lib/content";
import type { UIStrings } from "../lib/ui";
import { type Locale, LOCALES, DEFAULT_LOCALE, blogHome } from "../lib/i18n";
import LangSwitch from "./LangSwitch.astro";
import Mark from "./Mark.astro";

interface Props {
  locale: Locale;
  sections: readonly NavSection[];
  ui: UIStrings;
  /** Where the brand links. Defaults to the in-page top; sub-pages set this to
      the locale home so the mark behaves like a home link. */
  brandHref?: string;
  /** Per-locale URL for the language switch (sub-pages keep you on the page). */
  langPaths?: Partial<Record<Locale, string>>;
  /** Kept for the callers that still pass it; the bar is always solid now. */
  solid?: boolean;
}

const { locale, sections, ui, brandHref = "#top", langPaths } = Astro.props;
const blogHref = blogHome(locale);
// In-page anchors only make sense on the page that has them.
const inPage = brandHref === "#top";
---

<header id="site-header" class="site-header">
  <div class="bar">
    <a class="brand" href={brandHref} aria-label={`${site.name}, ${ui.homeLabel}`}>
      <Mark size={26} />
      <span class="brand-name">{site.name}</span>
    </a>

    {inPage && (
      <nav class="sections" aria-label={ui.sectionsLabel}>
        {sections.map((s) => (
          <a href={`#${s.id}`}>{s.label}</a>
        ))}
      </nav>
    )}

    <div class="bar-right">
      {inPage && (
        <details class="menu">
          <summary class="navlink"><span class="menu-label">{ui.sectionsLabel}</span></summary>
          <nav aria-label={ui.sectionsLabel}>
            {sections.map((s) => (
              <a href={`#${s.id}`}>{s.label}</a>
            ))}
          </nav>
        </details>
      )}
      <a
        class="navlink"
        href={blogHref}
        aria-current={Astro.url.pathname.includes("/blog") ? "page" : undefined}
      >
        Blog
      </a>
      <button class="theme-toggle" type="button" aria-label={ui.themeLabel} aria-pressed="false">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
        </svg>
      </button>
      <LangSwitch
        locale={locale}
        locales={LOCALES}
        defaultLocale={DEFAULT_LOCALE}
        switchLabel={ui.langSwitchLabel}
        names={ui.langName}
        titles={ui.langSwitchTo}
        paths={langPaths}
      />
    </div>
  </div>
</header>

<script>
  // Theme toggle: flips against whatever is currently showing (stored choice
  // or OS preference) and remembers it.
  const root = document.documentElement;
  const dark = matchMedia("(prefers-color-scheme: dark)");
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === "dark" : dark.matches;
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const sync = () => toggle?.setAttribute("aria-pressed", String(isDark()));
  sync();
  dark.addEventListener("change", sync);
  toggle?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    sync();
  });

  // Close the narrow-screen section menu once a section is picked, or on
  // Escape (focus goes back to the toggle).
  for (const menu of document.querySelectorAll<HTMLDetailsElement>(".menu")) {
    for (const a of menu.querySelectorAll("a")) {
      a.addEventListener("click", () => (menu.open = false));
    }
    menu.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !menu.open) return;
      menu.open = false;
      menu.querySelector("summary")?.focus();
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    height: 3.5rem;
    max-width: var(--header-max);
    margin-inline: auto;
    padding-inline: var(--header-gutter);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }
  .brand-name {
    font-weight: 650;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .sections {
    display: flex;
    gap: var(--space-m);
    margin-left: auto;
  }
  .sections a,
  .navlink {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-dim);
    white-space: nowrap;
  }
  .sections a:hover,
  .navlink:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-dim);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--ink);
  }
  @media (pointer: coarse) {
    .theme-toggle {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
  .bar-right {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    flex-shrink: 0;
    margin-left: auto;
  }
  .sections + .bar-right {
    margin-left: var(--space-m);
    padding-left: var(--space-m);
    border-left: 1px solid var(--line);
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    cursor: pointer;
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary::after {
    content: " ▾";
    content: " ▾" / "";
  }
  /* Phones: the label gives way to an icon so EN / FR still fits; it stays
     in the accessibility tree as the summary's name. */
  @media (max-width: 520px) {
    .bar-right {
      gap: var(--space-s);
    }
    .bar {
      gap: var(--space-s);
    }
    .menu-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .menu summary {
      display: inline-flex;
      justify-content: center;
      min-width: 44px;
    }
    .menu summary::after {
      content: "☰";
      content: "☰" / "";
      font-size: 1.15em;
    }
  }
  .menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 0.9rem);
    display: grid;
    min-width: 11rem;
    padding-block: var(--space-2xs, 0.25rem);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }
  .menu nav a {
    padding: 0.7rem 1rem;
    font-size: var(--step--1);
    color: var(--ink);
  }
  .menu nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  @media (max-width: 900px) {
    .sections {
      display: none;
    }
    .menu {
      display: block;
    }
    .sections + .bar-right {
      margin-left: auto;
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 400px) {
    .brand :global(.mark) {
      display: none;
    }
  }
  @media (pointer: coarse) {
    .navlink,
    .brand,
    .menu summary {
      padding-block: 0.7rem;
    }
  }
</style>
