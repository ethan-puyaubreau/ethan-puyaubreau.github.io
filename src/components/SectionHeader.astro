---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<header class="sec-head">
  <h2 class="sec-title">{title}</h2>
  <div class="sec-intro">
    <slot />
  </div>
</header>

<style>
  .sec-head {
    padding-top: var(--space-2xl);
    margin-bottom: var(--space-l);
  }
  .sec-title {
    font-size: var(--step-4);
    max-width: 20ch;
  }
  .sec-intro {
    margin-top: var(--space-s);
    color: var(--ink-dim);
    max-width: var(--measure);
  }
  .sec-intro:empty {
    display: none;
  }
</style>
