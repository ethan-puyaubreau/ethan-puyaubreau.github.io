---
interface Props {
  num: string;
  label: string;
  title: string;
}
const { num, label, title } = Astro.props;
---

<header class="sec-head" data-reveal>
  <div class="sec-top">
    <span class="sec-num">/{num}</span>
    <span class="label">{label}</span>
  </div>
  <h2 class="sec-title">{title}</h2>
  <div class="sec-intro"><slot /></div>
</header>

<style>
  .sec-head {
    position: relative;
    padding-top: var(--space-xl);
    margin-bottom: var(--space-l);
  }
  /* The top rule is a pseudo so it can draw in left-to-right on reveal.
     Default (no JS / reduced motion) it is simply full width and visible. */
  .sec-head::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--line);
    transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal) .sec-head::before {
      transform: scaleX(0);
      transition: transform var(--dur-slow) var(--ease-out);
    }
    :global(html.reveal) .sec-head.in-view::before {
      transform: scaleX(1);
    }
  }
  .sec-top {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-top: var(--space-s);
  }
  .sec-num {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .sec-title {
    font-size: var(--step-4);
    max-width: 18ch;
    margin-top: var(--space-xs);
  }
  .sec-intro {
    margin-top: var(--space-s);
    color: var(--ink-dim);
    max-width: var(--measure);
  }
  .sec-intro:empty {
    display: none;
  }
</style>
