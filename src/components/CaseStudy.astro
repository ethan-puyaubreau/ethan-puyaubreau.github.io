---
import type { CaseStudy } from "../lib/content";
import type { UIStrings } from "../lib/ui";

interface Props {
  study: CaseStudy;
  ui: UIStrings;
}
const { study, ui } = Astro.props;
---

<article id={study.id} class="case">
  <p class="case-meta">
    <span>{study.kicker}</span>
    <span>{study.role}</span>
    <span>{study.period}</span>
  </p>
  <h3 class="case-title">{study.title}</h3>
  <p class="summary">{study.summary}</p>
  {study.body.map((b) => (
    <div class="block">
      <h4>{b.h}</h4>
      <p>{b.p}</p>
    </div>
  ))}
  {study.caveat && <p class="caveat">{study.caveat}</p>}
  <slot name="artifact" />
  <p class="stack">
    <span class="visually-hidden">{ui.stackLabel}: </span>
    {study.stack.join(" · ")}
  </p>
  {study.links && study.links.length > 0 && (
    <ul class="links">
      {study.links.map((l) => (
        <li>
          <a href={l.href} rel="noopener" target={l.href.startsWith("http") ? "_blank" : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  )}
</article>

<style>
  .case {
    max-width: var(--measure);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--line);
    scroll-margin-top: 5rem;
  }
  .case-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .case-meta span + span::before {
    content: "·";
    margin-inline: 0.55rem;
    color: var(--faint);
  }
  @media (max-width: 600px) {
    .case-meta {
      flex-direction: column;
    }
    .case-meta span + span::before {
      content: none;
    }
  }
  .case-title {
    margin-top: var(--space-xs);
    font-size: var(--step-3);
  }
  .summary {
    margin-top: var(--space-s);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink);
  }
  .block {
    margin-top: var(--space-m);
  }
  .block h4 {
    font-size: var(--step-0);
    font-weight: 650;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3xs);
  }
  .block p {
    color: var(--ink-dim);
  }
  .caveat {
    margin-top: var(--space-m);
    color: var(--muted);
    font-size: var(--step--1);
  }
  .stack {
    margin-top: var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
  }
  .links {
    list-style: none;
    padding: 0;
    margin: var(--space-s) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
  }
  .links a {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .links a:hover {
    text-decoration-color: currentColor;
  }
</style>
