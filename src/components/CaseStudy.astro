---
import type { CaseStudy } from "../lib/content";
import type { UIStrings } from "../lib/ui";

interface Props {
  study: CaseStudy;
  ui: UIStrings;
}
const { study, ui } = Astro.props;
const hasSide = Boolean(study.image || study.figures || Astro.slots.has("artifact"));
---

<article id={study.id} class:list={["case", { compact: study.compact, "has-side": hasSide }]}>
  <div class="case-text">
    <p class="case-meta">
      <span>{study.kicker}</span>
      <span>{study.role}</span>
      <span>{study.period}</span>
    </p>
    <h3 class="case-title">{study.title}</h3>
    <p class="summary">{study.summary}</p>
    {!study.compact &&
      study.body.map((b) => (
        <div class="block">
          <h4>{b.h}</h4>
          <p>{b.p}</p>
        </div>
      ))}
    {!study.compact && study.caveat && <p class="caveat">{study.caveat}</p>}
    {!study.compact && (
      <p class="stack">
        <span class="visually-hidden">{ui.stackLabel}: </span>
        {study.stack.join(" · ")}
      </p>
    )}
    {study.links && study.links.length > 0 && (
      <ul class="links">
        {study.links.map((l) => (
          <li>
            <a
              href={l.href}
              rel="noopener"
              target={l.href.startsWith("http") ? "_blank" : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>

  {hasSide && (
    <div class="case-side">
      {study.image && (
        <a class="case-image" href={study.image.href}>
          <img
            src={study.image.src}
            alt={study.image.alt}
            width={study.image.width}
            height={study.image.height}
            loading="lazy"
            decoding="async"
          />
        </a>
      )}
      {study.figures && (
        <dl class="figures">
          {study.figures.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )}
      <slot name="artifact" />
    </div>
  )}
</article>

<style>
  .case {
    padding-block: var(--space-xl);
    border-top: 1px solid var(--line);
    scroll-margin-top: 5rem;
  }
  .case-text {
    max-width: var(--measure);
  }
  @media (min-width: 1024px) {
    .case.has-side {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      gap: var(--space-2xl);
      align-items: start;
    }
  }
  .case.compact {
    padding-block: var(--space-l);
  }
  .case-meta {
    display: flex;
    flex-wrap: wrap;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .case-meta span + span::before {
    content: "·";
    margin-inline: 0.55rem;
    color: var(--faint);
  }
  @media (max-width: 600px) {
    .case-meta {
      flex-direction: column;
    }
    .case-meta span + span::before {
      content: none;
    }
  }
  .case-title {
    margin-top: var(--space-xs);
    font-size: var(--step-3);
  }
  .compact .case-title {
    font-size: var(--step-2);
  }
  .summary {
    margin-top: var(--space-s);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink);
  }
  .compact .summary {
    font-size: var(--step-0);
    color: var(--ink-dim);
  }
  .block {
    margin-top: var(--space-m);
  }
  .block h4 {
    font-size: var(--step-0);
    font-weight: 650;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3xs);
  }
  .block p {
    color: var(--ink-dim);
  }
  .caveat {
    margin-top: var(--space-m);
    color: var(--muted);
    font-size: var(--step--1);
  }
  .stack {
    margin-top: var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
  }
  .links {
    list-style: none;
    padding: 0;
    margin: var(--space-s) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
  }
  .links a {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .links a:hover {
    text-decoration-color: currentColor;
  }

  .case-side {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-l);
  }
  @media (min-width: 1024px) {
    .case-side {
      margin-top: 0;
      position: sticky;
      top: 5rem;
    }
  }
  .case-image {
    display: block;
    max-width: 20rem;
    border: 1px solid var(--line);
  }
  .case-image img {
    width: 100%;
    height: auto;
  }
  .case-image:hover {
    border-color: var(--line-strong);
  }
  .figures {
    margin: 0;
    display: grid;
    gap: var(--space-s);
  }
  .figures div {
    display: flex;
    flex-direction: column-reverse;
    border-top: 1px solid var(--line);
    padding-top: var(--space-2xs);
  }
  .figures dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .figures dt {
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
