---
import type { MoreWorkItem } from "../lib/content";

interface Props {
  items: readonly MoreWorkItem[];
  head: string;
  label: string;
}
const { items, head, label } = Astro.props;
---

<aside class="more" aria-label={label}>
  <h3 class="more-head">{head}</h3>
  <ul>
    {items.map((item) => (
      <li>
        <span class="name">{item.name}</span>
        <p class="blurb">
          {item.blurb}{" "}
          {item.href ? (
            <a href={item.href} rel="noopener" target="_blank">
              {item.hrefLabel}
            </a>
          ) : (
            <span class="soon">({item.noLinkLabel})</span>
          )}
        </p>
      </li>
    ))}
  </ul>
</aside>

<style>
  .more {
    margin-top: var(--space-l);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .more-head {
    font-size: var(--step-1);
    margin-bottom: var(--space-2xs);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: clamp(0.75rem, 3vw, 2rem);
    align-items: baseline;
    padding-block: var(--space-s);
    border-top: 1px solid var(--hairline);
  }
  li:first-child {
    border-top: 0;
  }
  .name {
    font-weight: 650;
    color: var(--ink);
  }
  .blurb {
    color: var(--ink-dim);
    max-width: 62ch;
  }
  a {
    font-size: var(--step--1);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  a:hover {
    text-decoration-color: currentColor;
  }
  .soon {
    font-size: var(--step--1);
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr auto;
    }
    .blurb {
      grid-column: 1 / -1;
    }
  }
</style>
