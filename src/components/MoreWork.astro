---
import type { MoreWorkItem } from "../lib/content";

interface Props {
  items: readonly MoreWorkItem[];
  head: string;
  label: string;
}
const { items, head, label } = Astro.props;
---

<aside class="more" aria-label={label}>
  <p class="label more-head">{head}</p>
  <ul>
    {
      items.map((item, i) => (
        <li data-reveal style={`--ri: ${i}`}>
          <span class="name">{item.name}</span>
          <span class="blurb">{item.blurb}</span>
          {item.href ? (
            <a href={item.href} rel="noopener" target="_blank">
              {item.hrefLabel} <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <span class="soon">{item.noLinkLabel}</span>
          )}
        </li>
      ))
    }
  </ul>
</aside>

<style>
  .more {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }
  .more-head {
    margin-bottom: var(--space-s);
    color: var(--accent-deep);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr) auto;
    gap: clamp(0.75rem, 3vw, 2rem);
    align-items: baseline;
    padding-block: var(--space-s);
    border-top: 1px solid var(--hairline);
  }
  li:first-child {
    border-top: 0;
  }
  .name {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
  }
  .blurb {
    color: var(--ink-dim);
    font-size: var(--step--1);
    max-width: 56ch;
  }
  a {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    color: var(--ink);
    white-space: nowrap;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .soon {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr auto;
    }
    .blurb {
      grid-column: 1 / -1;
    }
  }
</style>
