---
import { site, links } from "../lib/site";
import type { Availability } from "../lib/content";

interface Props {
  availability: Availability;
  cv: string;
  cvKind: string;
  /** Locale-specific CV path (EN at /, FR at /fr). */
  cvHref: string;
}
const { availability, cv, cvKind, cvHref } = Astro.props;

const confirmed = links.filter((l) => l.confirmed && l.href);
---

<div class="contact">
  <div class="pitch">
    <p class="avail-head">{availability.headline}</p>
    <p class="avail-detail">{availability.detail}</p>
    <a
      class="primary"
      href={`mailto:${site.email}?subject=${encodeURIComponent(availability.mailSubject)}`}
    >
      {site.email.split("@")[0]}@<wbr />{site.email.split("@")[1]}
    </a>
  </div>

  <ul class="link-list">
    {confirmed.map((l) => (
      <li>
        <a href={l.href} rel="noopener" target="_blank">
          {l.label}
        </a>
      </li>
    ))}
    <li>
      <a href={cvHref} download>
        {cv} <span class="aside">({cvKind})</span>
      </a>
    </li>
  </ul>
</div>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 16rem);
    gap: clamp(1.5rem, 6vw, 4.5rem);
    align-items: start;
    padding-bottom: var(--space-2xl);
  }
  .avail-head {
    font-size: var(--step-2);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: 1.15;
    max-width: 24ch;
  }
  .avail-detail {
    color: var(--ink-dim);
    margin-top: var(--space-2xs);
    max-width: 44ch;
  }
  .primary {
    display: inline-block;
    margin-top: var(--space-m);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow-wrap: normal;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .primary:hover {
    text-decoration-color: currentColor;
  }
  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .link-list li {
    border-top: 1px solid var(--line);
  }
  .link-list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .link-list a {
    display: block;
    padding: var(--space-xs) 0;
    font-weight: 500;
  }
  .link-list a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .aside {
    font-weight: 400;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
