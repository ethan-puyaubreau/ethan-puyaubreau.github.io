---
// Shared composition for the cluster page. Both routes (src/pages/cluster.astro
// EN, src/pages/fr/cluster.astro FR) render this with their locale, so the
// structure lives in one place. House style: no em dashes.
import Base from "../layouts/Base.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import SectionHeader from "./SectionHeader.astro";
import ClusterNodes from "../islands/ClusterNodes.vue";
import ClusterPulse from "../islands/ClusterPulse.vue";
import ClusterServices from "../islands/ClusterServices.vue";
import RequestPath from "./RequestPath.astro";
import DeployPipeline from "./DeployPipeline.astro";
import { getUI } from "../lib/ui";
import { getClusterContent } from "../lib/cluster";
import { site } from "../lib/site";
import { localeHome, blogHome, type Locale } from "../lib/i18n";
import snapshot from "../data/cluster-snapshot.json";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const ui = getUI(locale);
const c = getClusterContent(locale);

// Per-locale URL so the language switch stays on this page.
const langPaths: Partial<Record<Locale, string>> = { en: "/cluster", fr: "/fr/cluster" };

const heroTitle = `${c.hero.lead}${c.hero.em}${c.hero.tail}`;

const asOf = new Date(snapshot.generatedAt).toLocaleDateString(
  locale === "fr" ? "fr-FR" : "en-US",
  {
    year: "numeric",
    month: "short",
    day: "numeric",
  },
);
---

<Base locale={locale} title={c.meta.title} description={c.meta.description}>
  <SiteHeader
    locale={locale}
    sections={c.sections}
    ui={ui}
    brandHref={localeHome(locale)}
    langPaths={langPaths}
  />

  <main id="main" tabindex="-1">
    <section id="top" class="hero container">
      <p class="hero-kicker">{c.hero.kicker}</p>
      <h1 class="hero-title">{heroTitle}</h1>
      <p class="hero-lede">{c.hero.lede}</p>
    </section>

    <div class="container">
      <section id="nodes">
        <SectionHeader title={c.nodesHead.title}>{c.nodesHead.intro}</SectionHeader>
        <div class="pulse-wrap">
          <ClusterPulse
            strings={c.pulse}
            agg={snapshot.cluster}
            cpuHist={snapshot.history.map((h) => h.cpuPct)}
            memHist={snapshot.history.map((h) => h.memPct)}
            asOf={asOf}
            lang={locale}
          />
        </div>
        <ClusterNodes
          strings={c.live}
          nodes={c.nodes}
          snapshot={snapshot.nodes}
          asOf={asOf}
          lang={locale}
        />
      </section>

      <section id="path">
        <SectionHeader title={c.pathHead.title}>{c.pathHead.intro}</SectionHeader>
        <RequestPath stages={c.path} label={c.pathHead.title} />
      </section>

      <section id="services">
        <SectionHeader title={c.servicesHead.title}>{c.servicesHead.intro}</SectionHeader>
        <ClusterServices
          strings={c.services}
          up={snapshot.servicesUp}
          total={snapshot.servicesTotal}
        />
      </section>

      <section id="pipeline">
        <SectionHeader title={c.pipelineHead.title}>{c.pipelineHead.intro}</SectionHeader>
        <DeployPipeline stages={c.pipeline.stages} note={c.pipeline.note} />
      </section>

      <section id="stack">
        <SectionHeader title={c.stackHead.title}>{c.stackHead.intro}</SectionHeader>
        <ul class="stack-grid" aria-label={c.stackHead.title}>
          {c.stack.map((s) => (
            <li class="stack-item">
              <span class="stack-name">{s.name}</span>
              <span class="stack-note">{s.note}</span>
            </li>
          ))}
        </ul>
      </section>

      <section id="operations">
        <SectionHeader title={c.opsHead.title}>{c.opsHead.intro}</SectionHeader>
        <div class="ops">
          <p class="ops-oncall">{c.ops.oncall}</p>
          <p class="ops-monitor">{c.ops.monitoring}</p>
          <div class="ops-runbooks">
            <h3 class="ops-rb-title">{c.ops.runbooksTitle}</h3>
            <p>{c.ops.runbooksBody}</p>
          </div>
        </div>
      </section>

      <aside id="hire" class="talk">
        <h2 class="talk-head">{c.talk.head}</h2>
        <p class="talk-body">{c.talk.body}</p>
        <a
          class="talk-cta"
          href={`mailto:${site.email}?subject=${encodeURIComponent(ui.contactMailSubject)}`}
        >
          {site.email}
        </a>
      </aside>
    </div>
  </main>

  <SiteFooter
    colophon={ui.colophon}
    buildLabel={ui.footerBuildLabel}
    commitLabel={ui.footerCommit}
    builtLabel={ui.footerBuilt}
    contactHref={`mailto:${site.email}?subject=${encodeURIComponent(ui.contactMailSubject)}`}
    contactLabel={ui.blog.contactCta}
    owner={site.name}
    blogHref={blogHome(locale)}
  />
</Base>

<style>
  .hero {
    padding-top: calc(3.5rem + var(--space-2xl));
    padding-bottom: var(--space-l);
  }
  .hero-kicker {
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: var(--space-m);
  }
  .hero-title {
    font-size: var(--step-6);
    max-width: 18ch;
  }
  .hero-lede {
    margin-top: var(--space-m);
    max-width: 56ch;
    color: var(--ink-dim);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  main > .container > section {
    scroll-margin-top: 4.5rem;
  }
  .pulse-wrap {
    max-width: 42rem;
    margin-top: var(--space-l);
  }
  #operations {
    padding-bottom: var(--space-xl);
  }
  .ops {
    margin-top: var(--space-l);
    display: grid;
    gap: var(--space-m);
    max-width: var(--measure);
  }
  .ops-oncall {
    font-size: var(--step-1);
    color: var(--ink);
  }
  .ops-monitor {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .ops-runbooks {
    border-top: 1px solid var(--line);
    padding-top: var(--space-s);
  }
  .ops-rb-title {
    font-size: var(--step-0);
    margin-bottom: var(--space-2xs);
  }
  .ops-runbooks p {
    color: var(--ink-dim);
  }

  .stack-grid {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .stack-item {
    background: var(--bg);
    padding: var(--space-s) var(--space-m);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .stack-name {
    font-weight: 600;
    color: var(--ink);
  }
  .stack-note {
    font-size: var(--step--2);
    color: var(--muted);
  }
  /* Call to action: closes the page instead of dead-ending on the console. */
  .talk {
    margin-block: var(--space-2xl) var(--space-xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
    max-width: var(--measure);
  }
  .talk-head {
    font-size: var(--step-3);
    max-width: 24ch;
  }
  .talk-body {
    margin-top: var(--space-s);
    color: var(--ink-dim);
    max-width: 52ch;
  }
  .talk-cta {
    display: inline-block;
    margin-top: var(--space-m);
    font-size: var(--step-1);
    font-weight: 600;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .talk-cta:hover {
    text-decoration-color: currentColor;
  }
</style>
