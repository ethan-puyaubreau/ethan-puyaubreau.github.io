---
// The mark: a power trace with the area under it filled. The area is the
// energy, which is the whole subject of the site. Same drawing as favicon.svg.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  class:list={["mark", className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <path class="mark-area" d="M3 26 H9 V12 H14 V15 H19 V9 H24 V26 Z"></path>
  <path class="mark-line" d="M3 26 H9 V12 H14 V15 H19 V9 H24 V26 H29"></path>
</svg>

<style>
  .mark {
    flex-shrink: 0;
  }
  .mark-area {
    fill: var(--accent-fill);
  }
  .mark-line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.2;
    stroke-linejoin: miter;
    stroke-linecap: square;
  }
</style>
