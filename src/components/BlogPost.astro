---
// Single blog post. Renders the Markdown body inside the paper layout, with a
// BlogPosting JSON-LD block for search engines. Both locales render this with
// their own entry. House style: no em dashes.
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import { getUI } from "../lib/ui";
import { site } from "../lib/site";
import { type Locale, localeHome, blogHome, blogPost } from "../lib/i18n";
import avatar from "../assets/avatar.jpg";

interface Props {
  locale: Locale;
  entry: CollectionEntry<"blog">;
}
const { locale, entry } = Astro.props;
const { Content } = await render(entry);

const ui = getUI(locale);
const d = entry.data;

// EN-only (or FR-only) posts have no counterpart in the other locale. Detect it
// so we neither emit an hreflang to a 404 (Base `paired`) nor point the language
// switch at a missing translation (omitted, so it falls back to that locale's home).
const other: Locale = locale === "en" ? "fr" : "en";
const hasOther =
  (await getCollection("blog", (p) => p.data.lang === other && p.data.slug === d.slug)).length > 0;
const langPaths: Partial<Record<Locale, string>> = { [locale]: blogPost(locale, d.slug) };
if (hasOther) langPaths[other] = blogPost(other, d.slug);
const fmtDate = (date: Date) =>
  date.toLocaleDateString(locale === "fr" ? "fr-FR" : "en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
const dateLabel = fmtDate(d.pubDate);
const updatedLabel = d.updatedDate ? fmtDate(d.updatedDate) : null;
const canonical = d.canonical ?? new URL(blogPost(locale, d.slug), site.url).href;
const ogImage = new URL("/og.png", site.url).href;
const logoUrl = new URL("/favicon-32.png", site.url).href;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  inLanguage: locale,
  keywords: d.tags.join(", "),
  image: ogImage,
  author: { "@type": "Person", "@id": `${site.url}#person`, name: site.name, url: site.url },
  publisher: {
    "@type": "Organization",
    name: site.name,
    url: site.url,
    logo: { "@type": "ImageObject", url: logoUrl },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
};
---

<Base
  locale={locale}
  title={`${d.title} · ${site.name}`}
  description={d.description}
  ogType="article"
  paired={hasOther}
  ogImage={`/og/${locale}/${d.slug}.png`}
  ogImageAlt={d.title}
>
  <SiteHeader
    locale={locale}
    sections={[]}
    ui={ui}
    brandHref={localeHome(locale)}
    langPaths={langPaths}
    solid
  />
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline></script>
  <main id="main" tabindex="-1" class="post-main">
    <article class="container post">
      <a class="back" href={blogHome(locale)}>
        {ui.blog.backToIndex}
      </a>
      <header class="post-head">
        <p class="label post-date">
          {ui.blog.published} {dateLabel}
          {updatedLabel && `, ${ui.blog.updated} ${updatedLabel}`}
        </p>
        <h1 class="post-title">{d.title}</h1>
        <p class="post-desc">{d.description}</p>
        {d.tags.length > 0 && (
          <p class="post-tags">
            <span class="visually-hidden">{ui.blog.tagsLabel} </span>
            {d.tags.join(" · ")}
          </p>
        )}
      </header>
      <div class="prose">
        <Content />
      </div>

      <footer class="author-card">
        <Image src={avatar} alt="" width={88} densities={[1, 2]} class="author-avatar" />
        <div class="author-meta">
          <p class="author-name">{site.name}</p>
          <p class="author-tagline">{ui.blog.authorTagline}</p>
          <p class="author-available">{ui.blog.authorAvailable}</p>
        </div>
        <a class="author-cta" href={`${localeHome(locale)}#contact`}>
          {ui.blog.contactCta}
        </a>
      </footer>
    </article>
  </main>

  <SiteFooter
    colophon={ui.colophon}
    buildLabel={ui.footerBuildLabel}
    commitLabel={ui.footerCommit}
    builtLabel={ui.footerBuilt}
    contactHref={`mailto:${site.email}?subject=${encodeURIComponent(ui.contactMailSubject)}`}
    contactLabel={ui.blog.contactCta}
    owner={site.name}
    blogHref={blogHome(locale)}
  />
</Base>

<style>
  .post-main {
    padding-top: calc(3.5rem + var(--space-2xl));
    padding-bottom: var(--space-2xl);
  }
  .post {
    max-width: 42rem;
  }
  .back {
    display: inline-block;
    margin-bottom: var(--space-l);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-dim);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .back:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }
  .post-date {
    margin-bottom: var(--space-s);
  }
  .post-title {
    font-size: var(--step-5);
    line-height: 1.06;
  }
  .post-desc {
    margin-top: var(--space-m);
    max-width: 50ch;
    color: var(--ink-dim);
    font-size: var(--step-1);
  }
  .post-tags {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .prose {
    margin-top: var(--space-xl);
  }
  .prose :global(h2) {
    font-size: var(--step-3);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-s);
  }
  .prose :global(p) {
    margin-bottom: var(--space-m);
    line-height: 1.7;
    color: var(--ink);
  }
  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .prose :global(a:hover) {
    text-decoration-color: currentColor;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--bg-sunken);
    padding: 0.05em 0.15em;
    border-radius: var(--radius);
    white-space: nowrap;
  }
  .prose :global(pre) {
    overflow-x: auto;
    padding: var(--space-m);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    margin-bottom: var(--space-m);
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-m);
    font-variant-numeric: tabular-nums;
  }
  .prose :global(caption) {
    caption-side: bottom;
    text-align: left;
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2xs) var(--space-xs) var(--space-2xs) 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: baseline;
  }
  .prose :global(thead th) {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--muted);
  }
  .prose :global(td) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    white-space: nowrap;
  }
  .prose :global(tbody th code) {
    background: none;
    padding: 0;
    white-space: nowrap;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-m) 1.4rem;
    line-height: 1.7;
  }
  /* Figures: diagrams (inline SVG) and photos scale to the column; captions are
     muted. Posts may carry several of each (e.g. the GPU-energy write-up). */
  .prose :global(figure) {
    margin: var(--space-l) 0;
  }
  .prose :global(figure > a) {
    display: block;
  }
  /* Diagrams keep a readable size on phones: the SVG scrolls sideways inside
     its own focusable wrapper, and the caption stays put below it. */
  @media (max-width: 640px) {
    .prose :global(.scroll) {
      overflow-x: auto;
      /* Fade at the right edge: the diagram continues off screen. */
      mask-image: linear-gradient(to right, #000 90%, transparent);
    }
    .prose :global(.scroll > svg) {
      min-width: 560px;
    }
  }
  .prose :global(figure svg),
  .prose :global(figure img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .prose :global(figure img) {
    border: 1px solid var(--line);
  }
  .prose :global(figcaption) {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--muted);
  }

  /* End note: detail kept out of the argument, one click away from it. */
  .prose :global(.note) {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--muted);
    scroll-margin-top: 5rem;
  }

  /* Author card: a reader who lands straight on the article still sees who
     wrote it, that they are available, and a one-click path to contact. */
  .author-card {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    flex-wrap: wrap;
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    flex-shrink: 0;
  }
  .author-meta {
    flex: 1 1 16rem;
    min-width: 0;
  }
  .author-name {
    font-weight: 650;
    color: var(--ink);
  }
  .author-tagline {
    font-size: var(--step--1);
    color: var(--ink-dim);
  }
  .author-available {
    font-size: var(--step--1);
    color: var(--muted);
    margin-top: 0.2rem;
  }
  .author-cta {
    flex-shrink: 0;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .author-cta:hover {
    text-decoration-color: currentColor;
  }
  @media (pointer: coarse) {
    .back,
    .author-cta {
      padding-block: 0.7rem;
    }
  }
</style>
