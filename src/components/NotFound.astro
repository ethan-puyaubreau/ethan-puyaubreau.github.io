---
// The 404 page, built once at /404.
// Minimal by design (no nav), matching the original. House style: no em dashes.
// GitHub Pages serves only the root 404.html, so a missing /fr/ page gets the
// English build; the inline script below switches it to the French copy.
import Base from "../layouts/Base.astro";
import { site } from "../lib/site";
import { getUI } from "../lib/ui";
import { type Locale, localeHome } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = getUI(locale);
const home = localeHome(locale);
const fr = getUI("fr");
const frCopy = {
  lede: fr.notFoundLede,
  back: fr.notFoundBack,
  home: localeHome("fr"),
  skip: fr.skipToContent,
  title: `${fr.notFoundTitle} · ${site.name}`,
};
---

<Base
  locale={locale}
  title={`${ui.notFoundTitle} · ${site.name}`}
  description={ui.notFoundDescription}
  noindex
>
  <main id="main" class="container nf">
    <h1>{ui.notFoundTitle}</h1>
    <p class="nf-lede">{ui.notFoundLede}</p>
    <a class="nf-back" href={home}>
      {ui.notFoundBack}
    </a>
  </main>
  {
    locale === "en" && (
      <script is:inline define:vars={{ frCopy }}>
        if (location.pathname.startsWith("/fr/")) {
          document.documentElement.lang = "fr";
          document.title = frCopy.title;
          document.querySelector(".skip-link").textContent = frCopy.skip;
          document.querySelector(".nf-lede").textContent = frCopy.lede;
          const back = document.querySelector(".nf-back");
          back.textContent = frCopy.back;
          back.href = frCopy.home;
        }
      </script>
    )
  }
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-s);
  }
  .nf h1 {
    font-size: var(--step-7);
    font-variant-numeric: tabular-nums;
  }
  .nf-lede {
    color: var(--ink-dim);
    max-width: 44ch;
  }
  .nf-back {
    margin-top: var(--space-m);
    font-weight: 600;
    align-self: flex-start;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .nf-back:hover {
    text-decoration-color: currentColor;
  }
</style>
