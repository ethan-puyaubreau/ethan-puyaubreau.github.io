---
// Blog index for a locale. Lists published posts in that language, newest first.
// House style: no em dashes.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import { getUI } from "../lib/ui";
import { site } from "../lib/site";
import { type Locale, localeHome, blogHome, blogPost } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = getUI(locale);

const posts = (await getCollection("blog", (p) => p.data.lang === locale && !p.data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const langPaths: Partial<Record<Locale, string>> = {
  en: blogHome("en"),
  fr: blogHome("fr"),
};
const fmt = (d: Date): string =>
  d.toLocaleDateString(locale === "fr" ? "fr-FR" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<Base
  locale={locale}
  title={`${ui.blog.indexTitle} · ${site.name}`}
  description={ui.blog.metaDescription}
>
  <SiteHeader
    locale={locale}
    sections={[]}
    ui={ui}
    brandHref={localeHome(locale)}
    langPaths={langPaths}
    solid
  />

  <main id="main" tabindex="-1" class="index-main">
    <div class="container">
      <header class="index-head">
        <h1 class="index-title">{ui.blog.indexTitle}</h1>
        <p class="index-intro">{ui.blog.indexIntro}</p>
      </header>

      {posts.length === 0 ? (
        <p class="empty">{ui.blog.empty}</p>
      ) : (
        <ul class="post-list">
          {posts.map((p) => (
            <li class="post-row">
              <a href={blogPost(locale, p.data.slug)}>
                <span class="row-date">{fmt(p.data.pubDate)}</span>
                <span class="row-title">{p.data.title}</span>
                <span class="row-desc">{p.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      <p class="talk">
        {ui.blog.talkHead}{" "}
        <a href={`mailto:${site.email}?subject=${encodeURIComponent(ui.contactMailSubject)}`}>
          {site.email}
        </a>
      </p>
    </div>
  </main>

  <SiteFooter
    colophon={ui.colophon}
    buildLabel={ui.footerBuildLabel}
    commitLabel={ui.footerCommit}
    builtLabel={ui.footerBuilt}
    contactHref={`mailto:${site.email}?subject=${encodeURIComponent(ui.contactMailSubject)}`}
    contactLabel={ui.blog.contactCta}
    owner={site.name}
    blogHref={blogHome(locale)}
  />
</Base>

<style>
  .index-main {
    padding-top: calc(3.5rem + var(--space-2xl));
    padding-bottom: var(--space-2xl);
  }
  .index-title {
    font-size: var(--step-5);
  }
  .index-intro {
    margin-top: var(--space-s);
    max-width: 52ch;
    color: var(--ink-dim);
    font-size: var(--step-1);
  }
  .empty {
    margin-top: var(--space-xl);
    color: var(--muted);
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: var(--space-xl) 0 0;
    border-top: 1px solid var(--line);
  }
  .post-row a {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.25rem var(--space-l);
    padding: var(--space-l) 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .post-row a:hover .row-title {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-thickness: 1px;
  }
  .row-date {
    font-size: var(--step--1);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .row-title {
    grid-column: 2;
    font-size: var(--step-2);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: 1.15;
    color: var(--ink);
  }
  .row-desc {
    grid-column: 2;
    margin-top: 0.3rem;
    max-width: 62ch;
    color: var(--ink-dim);
  }
  .talk {
    margin-top: var(--space-xl);
    color: var(--ink-dim);
  }
  .talk a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .talk a:hover {
    text-decoration-color: currentColor;
  }
  @media (max-width: 640px) {
    .post-row a {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
    .row-title,
    .row-desc {
      grid-column: 1;
    }
  }
</style>
