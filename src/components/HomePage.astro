---
// Shared home composition. Both routes (src/pages/index.astro EN,
// src/pages/fr/index.astro FR) render this with their locale, so the structure
// lives in one place and only the language differs. House style: no em dashes.
import Base from "../layouts/Base.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import SectionHeader from "./SectionHeader.astro";
import CaseStudyEntry from "./CaseStudy.astro";
import MoreWork from "./MoreWork.astro";
import About from "./About.astro";
import Contact from "./Contact.astro";
import PowerTrace from "./PowerTrace.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { site, refs, getSiteCopy, links } from "../lib/site";
import { getContent } from "../lib/content";
import { getUI } from "../lib/ui";
import { type Locale, blogHome, blogPost } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = getSiteCopy(locale);
const ui = getUI(locale);
const content = getContent(locale);

// Verifiable references surfaced in the hero (credibility before the argument).
const proofLinks = links.filter(
  (l) => l.confirmed && ["ORCID", "Google Scholar", "GitHub", "LinkedIn"].includes(l.label),
);
const heads = ui.sectionHeads;
const cvHref = locale === "fr" ? "/Ethan-Puyaubreau-CV-FR.pdf" : "/Ethan-Puyaubreau-CV.pdf";

// Latest blog posts for the "Writing" teaser section. Newest first, capped at 3
// so it stays a teaser and does not compete with the case studies above it.
const posts = (
  await getCollection(
    "blog",
    (p: CollectionEntry<"blog">) => p.data.lang === locale && !p.data.draft,
  )
)
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  )
  .slice(0, 3);
const fmtDate = (d: Date): string =>
  d.toLocaleDateString(locale === "fr" ? "fr-FR" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<Base locale={locale}>
  <SiteHeader
    locale={locale}
    sections={content.sections}
    ui={ui}
    langPaths={{ en: "/", fr: "/fr" }}
  />

  <main id="main" tabindex="-1">
    <section id="top" class="hero container">
      <p class="hero-who">
        {copy.role} · {ui.hero.availability}
      </p>
      <h1 class="hero-title">{ui.hero.title}</h1>
      <div class="hero-body">
        <div class="hero-text">
          <p class="hero-lede">
            {ui.hero.ledeBeforeLink}
            <a href={refs.kokkos} rel="noopener" target="_blank">
              {ui.hero.ledeLinkLabel}
            </a>
            {ui.hero.ledeAfterLink}
          </p>
          <p class="hero-links">
            {proofLinks.map((l) => (
              <a href={l.href} rel="noopener" target="_blank">
                {l.label}
              </a>
            ))}
            <a href={cvHref} download>
              {ui.cv} ({ui.cvKind})
            </a>
          </p>
        </div>
        <figure class="hero-figure">
          <PowerTrace label={ui.hero.figureLabel} locale={locale} />
          <figcaption>
            {ui.hero.figureCaption} <a href={ui.hero.figureLinkHref}>{ui.hero.figureLinkLabel}</a>
          </figcaption>
        </figure>
      </div>
    </section>

    <div class="container">
      <section id="work">
        <SectionHeader title={heads.work.title}>{heads.work.intro}</SectionHeader>
        {content.caseStudies.map((study) => (
          <CaseStudyEntry study={study} ui={ui} />
        ))}
        <MoreWork items={content.moreWork} head={ui.moreWorkHead} label={ui.moreWorkLabel} />
      </section>

      {posts.length > 0 && (
        <section id="writing">
          <SectionHeader title={ui.blog.indexTitle}>{ui.blog.indexIntro}</SectionHeader>
          <ul class="writing-list">
            {posts.map((p: CollectionEntry<"blog">) => (
              <li class="writing-row">
                <a href={blogPost(locale, p.data.slug)}>
                  <span class="w-date">{fmtDate(p.data.pubDate)}</span>
                  <span class="w-title">{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="writing-all" href={blogHome(locale)}>
            {ui.blog.seeAll}
          </a>
        </section>
      )}

      <section id="about">
        <SectionHeader title={heads.about.title} />
        <About
          about={content.about}
          timeline={content.timeline}
          role={copy.role}
          timelineLabel={ui.timelineLabel}
        />
      </section>

      <section id="contact">
        <SectionHeader title={heads.contact.title} />
        <Contact
          availability={content.availability}
          cv={ui.cv}
          cvKind={ui.cvKind}
          cvHref={locale === "fr" ? "/Ethan-Puyaubreau-CV-FR.pdf" : "/Ethan-Puyaubreau-CV.pdf"}
        />
      </section>
    </div>
  </main>

  <SiteFooter
    colophon={ui.colophon}
    buildLabel={ui.footerBuildLabel}
    commitLabel={ui.footerCommit}
    builtLabel={ui.footerBuilt}
    contactHref={`mailto:${site.email}?subject=${encodeURIComponent(ui.contactMailSubject)}`}
    contactLabel={ui.blog.contactCta}
    owner={site.name}
    blogHref={blogHome(locale)}
  />
</Base>

<style>
  .hero {
    padding-top: calc(3.5rem + var(--space-2xl));
    padding-bottom: var(--space-xl);
  }
  .hero-body {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }
  @media (min-width: 1024px) {
    .hero-body {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
      align-items: start;
    }
  }
  .hero-who {
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: var(--space-m);
  }
  .hero-title {
    font-size: var(--step-6);
    max-width: 25ch;
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: calc(3.5rem + var(--space-l));
    }
    .hero-body {
      margin-top: var(--space-l);
    }
  }
  @media (pointer: coarse) {
    .hero-links a {
      padding-block: 0.7rem;
    }
  }
  .hero-lede {
    max-width: 50ch;
    color: var(--ink-dim);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .hero-lede a,
  .hero-links a,
  .hero-figure figcaption a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .hero-lede a:hover,
  .hero-links a:hover,
  .hero-figure figcaption a:hover {
    text-decoration-color: currentColor;
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: var(--space-m);
    font-size: var(--step--1);
    font-weight: 500;
  }
  .hero-figure figcaption {
    margin-top: var(--space-s);
    max-width: 56ch;
    font-size: var(--step--1);
    color: var(--muted);
  }

  main > .container > section {
    scroll-margin-top: 4.5rem;
  }

  .writing-list {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0 0;
    border-top: 1px solid var(--line);
  }
  .writing-row a {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.2rem var(--space-l);
    padding: var(--space-m) 0;
    min-height: 44px;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .writing-row a:hover .w-title {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-thickness: 1px;
  }
  /* Whole-row affordance: an arrow appears at the end of the title on hover, so
     hovering the date or description still signals the row is clickable. */
  .w-date {
    font-size: var(--step--1);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .w-title {
    grid-column: 2;
    font-size: var(--step-2);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: 1.15;
    color: var(--ink);
  }
  .w-desc {
    grid-column: 2;
    margin-top: 0.25rem;
    color: var(--ink-dim);
    font-size: var(--step-0);
  }
  .writing-all {
    display: inline-block;
    margin-top: var(--space-l);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .writing-all:hover {
    text-decoration-color: currentColor;
  }
  @media (max-width: 640px) {
    .writing-row a {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
    .w-title,
    .w-desc {
      grid-column: 1;
    }
  }
</style>
