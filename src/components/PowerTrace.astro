---
// Two measured NVML power traces from the SMC 2025 poster runs (ArborX DBSCAN
// on an NVIDIA H100 NVL), drawn at build time as static SVG, one panel per run
// on a shared time axis that starts where the DBSCANCalculation region starts.
// The filled area is the energy inside that region; its duration and energy are
// printed beside each panel. Data: src/data/dbscan-traces.json, from the raw
// traces and Kokkos region timestamps of those runs.
import traces from "../data/dbscan-traces.json";

interface Props {
  label: string;
}
const { label } = Astro.props;

const W = 640;
const PANEL_H = 112;
const GAP = 40;
const PAD = { l: 48, r: 150, t: 8, b: 30 };
const H = PAD.t + PANEL_H * 2 + GAP + PAD.b;
const T0 = -0.4; // seconds shown before the region starts
const T1 = 3.0; // last second shown
const P_MAX = 360; // watts at the top of a panel

const x = (t: number) => PAD.l + ((t - T0) / (T1 - T0)) * (W - PAD.l - PAD.r);

type Panel = {
  key: string;
  durationS: number;
  energyJ: number;
  top: number;
  line: string;
  area: string;
  y: (p: number) => number;
};
const panels: Panel[] = (["fdbscan", "fdbscan-dense"] as const).map((key, i) => {
  const { durationS, energyJ, samples } = traces[key];
  const top = PAD.t + i * (PANEL_H + GAP);
  const y = (p: number) => top + (1 - p / P_MAX) * PANEL_H;
  const pts = samples.filter(([t]) => t >= T0 && t <= T1);
  const path = (ps: typeof pts) =>
    ps.map(([t, w], j) => `${j ? "L" : "M"}${x(t).toFixed(1)} ${y(w).toFixed(1)}`).join(" ");
  const inside = pts.filter(([t]) => t >= 0 && t <= durationS);
  const area = `${path(inside)} L${x(durationS).toFixed(1)} ${y(0)} L${x(0).toFixed(1)} ${y(0)} Z`;
  return { key, durationS, energyJ, top, line: path(pts), area, y };
});

const fmtS = (s: number) => `${s.toFixed(2)} s`;
const fmtJ = (j: number) => `${Math.round(j)} J`;
const xTicks = [0, 1, 2, 3];
---

<svg class="trace" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
  {
    panels.map((p, i) => (
      <g class:list={["panel", i === 1 ? "is-dense" : "is-scan"]}>
        <line class="axis" x1={PAD.l} x2={W - PAD.r} y1={p.y(0)} y2={p.y(0)} />
        <line class="grid" x1={PAD.l} x2={W - PAD.r} y1={p.y(300)} y2={p.y(300)} />
        <text class="tick" x={PAD.l - 8} y={p.y(300) + 5} text-anchor="end">
          300 W
        </text>
        <path class="area" d={p.area} />
        <path class="line" d={p.line} />
        <line class="end" x1={x(p.durationS)} x2={x(p.durationS)} y1={p.top - 4} y2={p.y(0)} />
        <text class="name" x={W - PAD.r + 18} y={p.top + 22}>
          {p.key}
        </text>
        <text class="joules" x={W - PAD.r + 18} y={p.top + 58}>
          {fmtJ(p.energyJ)}
        </text>
        <text class="secs" x={W - PAD.r + 18} y={p.top + 82}>
          {fmtS(p.durationS)}
        </text>
      </g>
    ))
  }
  <line class="start" x1={x(0)} x2={x(0)} y1={PAD.t - 4} y2={H - PAD.b} />
  {
    xTicks.map((t) => (
      <text class="tick" x={x(t)} y={H - 6} text-anchor="middle">
        {t} s
      </text>
    ))
  }
</svg>

<style>
  .trace {
    width: 100%;
    height: auto;
  }
  .axis {
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .grid {
    stroke: var(--hairline);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .start,
  .end {
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .tick {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--muted);
  }
  .name,
  .secs {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--ink-dim);
  }
  .joules {
    font-family: var(--font-mono);
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .line {
    fill: none;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .is-scan .area {
    fill: rgb(17 17 17 / 0.1);
  }
  .is-scan .line {
    stroke: var(--ink);
  }
  .is-scan .joules {
    fill: var(--ink);
  }
  .is-dense .area {
    fill: var(--accent-fill);
  }
  .is-dense .line {
    stroke: var(--accent);
  }
  .is-dense .joules {
    fill: var(--accent);
  }
</style>
