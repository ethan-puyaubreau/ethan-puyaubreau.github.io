---
import type { Domain } from "../lib/content";

interface Props {
  domains: readonly Domain[];
  provenByLabel: string;
}
const { domains, provenByLabel } = Astro.props;
---

<div class="domains">
  {domains.map((d) => (
    <section class="domain">
      <div class="domain-head">
        <h3>{d.title}</h3>
        <a class="proven" href={`#${d.provenBy.id}`}>
          {provenByLabel} {d.provenBy.label}
        </a>
      </div>
      <p class="domain-blurb">{d.blurb}</p>
      <p class="domain-items">{d.items.join(" · ")}</p>
    </section>
  ))}
</div>

<style>
  .domains {
    display: grid;
    gap: 0;
  }
  .domain {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: 0.4rem clamp(1rem, 4vw, 3rem);
    padding-block: var(--space-m);
    border-top: 1px solid var(--hairline);
    align-items: start;
  }
  .domain-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .domain-head h3 {
    font-size: var(--step-2);
  }
  .proven {
    font-size: var(--step--1);
    color: var(--muted);
    align-self: start;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .proven:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }
  .domain-blurb {
    color: var(--ink-dim);
    grid-column: 2;
  }
  .domain-items {
    grid-column: 2;
    font-size: var(--step--1);
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .domain {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
    .domain-blurb,
    .domain-items {
      grid-column: 1;
    }
  }
</style>
