---
// Source page for the 1200x630 Open Graph card. Captured to /og.png by
// scripts/shoot-og.mjs. Not indexed, not in the sitemap. Kept in English: the
// committed og.png is the EN card shared for all locales.
import "@fontsource-variable/archivo";
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import Mark from "../components/Mark.astro";
import PowerTrace from "../components/PowerTrace.astro";
import { site, getSiteCopy } from "../lib/site";
import { getUI } from "../lib/ui";

const copy = getSiteCopy("en");
const ui = getUI("en");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>OG card</title>
  </head>
  <body>
    <div class="og">
      <div class="copy">
        <p class="brand">
          <Mark size={40} />
          <span>{site.name}</span>
        </p>
        <h1>{ui.hero.title}</h1>
        <p class="role">
          {copy.role} · <span class="url">{site.url.replace("https://", "")}</span>
        </p>
      </div>
      <div class="chart">
        <PowerTrace label={ui.hero.figureLabel} />
      </div>
    </div>

    <style>
      :global(html),
      :global(body) {
        margin: 0;
        padding: 0;
      }
      .og {
        box-sizing: border-box;
        width: 1200px;
        height: 630px;
        padding: 64px 72px;
        display: grid;
        grid-template-columns: 500px 1fr;
        gap: 56px;
        align-items: center;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 0;
        font-size: 26px;
        font-weight: 650;
        letter-spacing: -0.01em;
      }
      h1 {
        margin: 36px 0 0;
        font-size: 50px;
        line-height: 1.04;
        font-weight: 650;
        letter-spacing: -0.03em;
      }
      .url {
        white-space: nowrap;
      }
      .role {
        margin: 28px 0 0;
        font-size: 20px;
        color: var(--muted);
      }
    </style>
  </body>
</html>
