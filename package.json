{
  "name": "ethan-puyaubreau-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfolio of Ethan Puyaubreau, HPC & infrastructure engineer. ethan-puyaubreau.github.io",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "check:vue": "vue-tsc --noEmit -p tsconfig.vue.json",
    "typecheck": "astro sync && astro check && vue-tsc --noEmit -p tsconfig.vue.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "og": "node scripts/shoot-og.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.0.3",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "astro": "^7.3.4",
    "sharp": "^0.35.4",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.19",
    "@webgpu/types": "^0.1.70",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-vue": "^10.9.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.3"
  }
}
